STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_backend_only_service_role_key
APP_URL=http://localhost:5173
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_unique_webhook_verify_token
WHATSAPP_TOKEN_ENCRYPTION_KEY=64_hex_characters_generate_securely
WHATSAPP_GRAPH_VERSION=v23.0
VITE_API_URL=http://localhost:5174


# Frontend anon/publishable key only. NEVER set VITE_SUPABASE_SERVICE_ROLE_KEY.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Backend AI spending guard (provider cost caps still require dedicated config)
GROQ_MAX_REPLY_TOKENS=500

# A publicly reachable HTTPS webhook URL for the integrations dashboard
VITE_WHATSAPP_WEBHOOK_URL=https://your-api-domain.example/webhook/whatsapp

# Optional isolated PostgreSQL test suite; NEVER point to production.
# DB name must end in _test, e.g. postgres://.../ezeji_test
# EZEJI_LIFECYCLE_TEST_DATABASE_URL=

# Production requires separate Render cron and worker secret configuration.
# Backend and worker must share the SAME Supabase project and encryption key.

# Shared web/preview/WhatsApp provider limits. No tools or optional JSON modes are enabled.
GROQ_CONNECTION_TIMEOUT_MS=8000
GROQ_RESPONSE_TIMEOUT_MS=15000
GROQ_MAX_ATTEMPTS=3
# Optional estimated provider cost reporting; defaults to unknown, never fabricated.
GROQ_INPUT_USD_PER_MILLION=0
GROQ_OUTPUT_USD_PER_MILLION=0
# Optional dedicated HMAC secret for anonymous abuse buckets; otherwise uses server key.
ASSISTANT_CLIENT_HASH_SECRET=generate_a_long_random_secret
# Deploy scripts/assistant-maintenance.js every minute for recovery and 30-day retention.
ASSISTANT_DATABASE_TIMEOUT_MS=10000
